{
  "name": "@0bull/sdk",
  "version": "0.2.0",
  "description": "Typed TypeScript client for the 0bull API",
  "license": "MIT",
  "author": "0bull",
  "homepage": "https://0bull.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0bull/0bull-typescript-sdk.git"
  },
  "keywords": [
    "0bull",
    "sdk",
    "api-client",
    "phone-automation",
    "video",
    "websocket"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
